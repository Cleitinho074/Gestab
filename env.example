# Copie este arquivo para .env em desenvolvimento local.
# Em produção (Railway/Render), essas variáveis vão no painel do serviço, não em arquivo.

# String de conexão do PostgreSQL. Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=

# Segredo usado para assinar os tokens JWT. Troque por um valor aleatório longo.
# Gerar um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL do frontend, usada pelo CORS. Se front e back estão no mesmo domínio (caso deste projeto), pode deixar em branco ou "*".
FRONTEND_URL=

# E-mail da conta demo legada (opcional, só é usado numa migração pontual)
DEMO_EMAIL=demo@meifacil.com.br

NODE_ENV=production
PORT=3000
